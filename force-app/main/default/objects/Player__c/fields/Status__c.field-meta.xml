    <label>Status</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Joined</fullName>
                <default>true</default>
                <label>Joined</label>
            </value>
            <value>
                <fullName>Left</fullName>
                <default>false</default>
                <label>Left</label>
            </value>
            <value>
                <fullName>Finished</fullName>
                <default>false</default>
                <label>Finished</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
